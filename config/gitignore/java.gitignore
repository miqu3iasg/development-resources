# Java (Maven, Gradle, Spring Boot)
# Starting point. Copy to the project root as .gitignore and adjust there.

# Build output
target/
build/
out/
bin/

# Maven
.mvn/timing.properties
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Gradle
.gradle/
.gradletasknamecache

# Compiled artifacts
*.class
*.jar
*.war
*.ear
*.nar
# Build wrappers are committed
!gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# Logs
*.log
logs/

# Secrets and local configuration: never commit
.env
.env.*
!.env.example
application-local.*
application-secret*.*
*.pem
*.p12
*.jks
*.keystore

# IntelliJ IDEA
.idea/*
*.iml
*.ipr
*.iws
!.idea/codeStyles/
!.idea/inspectionProfiles/

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db
Desktop.ini
*~
